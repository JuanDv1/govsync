        <mxCell id="E2" edge="1" parent="1" source="F6" style="endArrow=classic;html=1;strokeColor=#0050ef;strokeWidth=2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="B1" value="2. HTTPS /api/v1/* + Bearer JWT">
