# URL del backend. En desarrollo se usa el proxy de Vite y puede quedar vacía.
VITE_API_URL=http://localhost:8000

# Keycloak ([HU-E01-01], docs/DECISIONES.md D23/D24). VITE_KEYCLOAK_CLIENT_ID
# es el cliente PÚBLICO del frontend (govsync-frontend, con PKCE) — distinto
# del cliente "govsync-backend" que el backend exige como audience.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=govsync
VITE_KEYCLOAK_CLIENT_ID=govsync-frontend
